<div class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
  <header class="border-b border-gray-200 pb-6">
    <p class="text-sm text-gray-500">Signed in as <%= current_user.email %></p>
    <h1 class="mt-1 text-2xl font-semibold text-gray-950">Dashboard</h1>
  </header>

  <section class="py-8" aria-labelledby="chats-heading">
    <div class="flex items-center justify-between gap-4">
      <div>
        <h2 id="chats-heading" class="text-lg font-medium text-gray-950">Chats</h2>
        <p class="mt-1 text-sm text-gray-500">Start a conversation or return to an earlier one.</p>
      </div>
      <%= button_to "New chat", chats_path,
                    class: "rounded-md bg-gray-950 px-4 py-2 text-sm font-medium text-white hover:bg-gray-800" %>
    </div>

    <%= link_to "View existing chats", chats_path,
                class: "mt-5 inline-block text-sm font-medium text-gray-700 underline decoration-gray-300 underline-offset-4 hover:text-gray-950" %>
  </section>

  <nav class="border-t border-gray-200 py-8" aria-label="Account">
    <div class="grid gap-3 sm:grid-cols-2">
      <%= link_to users_aliases_path,
                  class: "block rounded-lg border border-gray-200 bg-white p-5 hover:border-gray-300 hover:bg-gray-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gray-500 focus-visible:ring-offset-2" do %>
        <span class="block text-sm font-medium text-gray-700">Aliases</span>
        <span class="mt-2 block text-3xl font-semibold text-gray-950"><%= @aliases_count %></span>
      <% end %>

      <%= link_to users_auth_tokens_path,
                  class: "block rounded-lg border border-gray-200 bg-white p-5 hover:border-gray-300 hover:bg-gray-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gray-500 focus-visible:ring-offset-2" do %>
        <span class="block text-sm font-medium text-gray-700">Connected Accounts</span>
        <span class="mt-2 block text-3xl font-semibold text-gray-950"><%= @auth_tokens_count %></span>
      <% end %>

      <%= link_to edit_users_settings_path,
                  class: "block rounded-lg border border-gray-200 bg-white p-5 hover:border-gray-300 hover:bg-gray-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gray-500 focus-visible:ring-offset-2" do %>
        <span class="block text-sm font-medium text-gray-700">Settings</span>
        <span class="mt-2 block text-sm text-gray-500"><%= current_user.timezone %></span>
      <% end %>
    </div>
  </nav>

  <%= button_to "Logout", users_session_path(current_user), method: :delete,
                class: "text-sm text-gray-500 hover:text-gray-950" %>
</div>
