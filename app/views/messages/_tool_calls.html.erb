<% tool_calls ||= local_assigns[:message] %>
<article id="message_<%= tool_calls.id %>" class="max-w-[95%] sm:max-w-[85%]">
  <p class="mb-1 text-xs font-medium text-gray-500">ISAAC</p>
  <div class="space-y-2">
    <% tool_calls.tool_calls.each do |tool_call| %>
      <details class="rounded-lg border border-gray-200 bg-gray-50 text-sm text-gray-700">
        <summary class="cursor-pointer rounded-lg px-3 py-2 font-medium text-gray-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gray-500">
          Used <%= tool_call.name.humanize %>
        </summary>
        <div class="border-t border-gray-200 px-3 py-3">
          <p class="text-xs font-medium uppercase tracking-wide text-gray-500">Arguments</p>
          <pre class="mt-1 overflow-x-auto whitespace-pre-wrap break-words rounded-md bg-white p-3 text-xs leading-5 text-gray-800"><%= format_tool_value(tool_call.arguments) %></pre>
        </div>
      </details>
    <% end %>
  </div>
  <p class="mt-1 text-xs text-gray-400"><%= tool_calls.created_at.strftime("%l:%M %p") %></p>
</article>
