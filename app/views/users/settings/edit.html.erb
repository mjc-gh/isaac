<% content_for :title, "Settings" %>

<main class="mx-auto max-w-xl px-4 py-8 sm:px-6">
  <header class="border-b border-gray-200 pb-5">
    <%= link_to "Dashboard", dashboards_path, class: "text-sm text-gray-500 hover:text-gray-950" %>
    <h1 class="mt-1 text-2xl font-semibold text-gray-950">Settings</h1>
    <p class="mt-2 text-sm leading-6 text-gray-500">Choose how ISAAC should interpret dates and times for you.</p>
  </header>

  <%= form_with model: current_user, url: users_settings_path, method: :patch, local: true, class: "py-6" do |form| %>
    <% if current_user.errors.any? %>
      <div id="error_explanation" class="mb-6 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
        <h2 class="font-medium"><%= pluralize(current_user.errors.count, "error") %> prohibited these settings from being saved:</h2>
        <ul class="mt-2 list-disc space-y-1 pl-5">
          <% current_user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= form.label :timezone, "Time zone", class: "block text-sm font-medium text-gray-800" %>
      <%= form.select :timezone, options_for_select(@timezones.map { |timezone| [timezone.to_s, timezone.name] }, current_user.timezone), {},
                      class: "mt-2 block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-gray-950 focus:border-gray-500 focus:outline-none focus:ring-1 focus:ring-gray-500" %>
      <p class="mt-2 text-sm text-gray-500">Dates and times in conversations will use this time zone.</p>
    </div>

    <div class="mt-6 flex items-center gap-4">
      <%= form.submit "Save", class: "rounded-md bg-gray-950 px-4 py-2 text-sm font-medium text-white hover:bg-gray-800" %>
      <%= link_to "Cancel", dashboards_path, class: "text-sm font-medium text-gray-600 hover:text-gray-950" %>
    </div>
  <% end %>
</main>
