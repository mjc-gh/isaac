<% content_for :title, "Connected Accounts" %>

<main class="mx-auto max-w-3xl px-4 py-8 sm:px-6">
  <header class="flex flex-col items-start justify-between gap-4 border-b border-gray-200 pb-5 sm:flex-row sm:items-center">
    <div>
      <%= link_to "Dashboard", dashboards_path, class: "text-sm text-gray-500 hover:text-gray-950" %>
      <h1 class="mt-1 text-2xl font-semibold text-gray-950">Connected Accounts</h1>
      <p class="mt-1 text-sm text-gray-500">Services Isaac can use on your behalf.</p>
    </div>
    <%= button_to "Connect Google Calendar", "/auth/google_oauth2",
                  data: { turbo: false },
                  class: "shrink-0 rounded-md bg-gray-950 px-4 py-2 text-sm font-medium text-white hover:bg-gray-800" %>
  </header>

  <% if @auth_tokens.any? %>
    <div class="overflow-x-auto py-5">
      <table class="min-w-full text-left text-sm">
        <thead class="border-b border-gray-200 text-xs font-medium uppercase tracking-wide text-gray-500">
          <tr>
            <th scope="col" class="py-3 pr-6 font-medium">Provider</th>
            <th scope="col" class="py-3 pr-6 font-medium">Status</th>
            <th scope="col" class="py-3 text-right font-medium">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% @auth_tokens.each do |token| %>
            <tr>
              <td class="py-4 pr-6 font-medium text-gray-950"><%= t token.provider, scope: "omniauth.providers" %></td>
              <td class="py-4 pr-6">
                <span class="inline-flex items-center gap-2 text-gray-600">
                  <span class="size-2 rounded-full bg-green-500" aria-hidden="true"></span>
                  Connected
                </span>
              </td>
              <td class="whitespace-nowrap py-4 text-right">
                <% if token.provider == "google_oauth2" %>
                  <%= link_to "Preferences", edit_users_calendar_preferences_path,
                              class: "text-sm font-medium text-gray-700 hover:text-gray-950" %>
                <% end %>
                <%= button_to "Disconnect", users_auth_token_path(token), method: :delete,
                              data: { turbo_confirm: "Disconnect this account?" },
                              form_class: "ml-4 inline-block",
                              class: "text-sm font-medium text-red-700 hover:text-red-900" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="py-16 text-center">
      <p class="text-gray-600">You don't have any connected accounts yet.</p>
      <p class="mt-2 text-sm text-gray-500">Connect a service to give Isaac access to the tools you choose.</p>
    </div>
  <% end %>
</main>
