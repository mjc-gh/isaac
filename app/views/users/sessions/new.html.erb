<div class="container">
  <h1>Sign in to ISAAC</h1>

  <%= form_with url: users_sessions_path, local: true do |form| %>
    <div class="form-group">
      <%= form.label :email %>
      <%= form.email_field :email, required: true %>
    </div>

    <%= form.submit "Send me a sign in link" %>
  <% end %>
</div>
