<% content_for :title, "Edit Alias" %>

<main class="mx-auto max-w-xl px-4 py-8 sm:px-6">
  <header class="border-b border-gray-200 pb-5">
    <%= link_to "Aliases", users_aliases_path, class: "text-sm text-gray-500 hover:text-gray-950" %>
    <h1 class="mt-1 text-2xl font-semibold text-gray-950">Edit Alias</h1>
    <p class="mt-2 text-sm text-gray-500">Update the address ISAAC recognizes as yours.</p>
  </header>

  <div class="py-6">
    <%= render "form", alias: @alias %>
  </div>
</main>
