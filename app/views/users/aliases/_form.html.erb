<%= form_with model: @alias, scope: :user_alias, url: (action_name == "edit" ? users_alias_path(@alias) : users_aliases_path), local: true do |form| %>
  <% if @alias.errors.any? %>
    <div id="error_explanation" class="mb-6 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
      <h2 class="font-medium"><%= pluralize(@alias.errors.count, "error") %> prohibited this alias from being saved:</h2>
      <ul class="mt-2 list-disc space-y-1 pl-5">
        <% @alias.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :email, class: "block text-sm font-medium text-gray-800" %>
    <%= form.email_field :email, required: true, autofocus: true,
                         autocomplete: "email", placeholder: "you@example.com",
                         class: "mt-2 block w-full rounded-md border border-gray-300 px-3 py-2 text-gray-950 placeholder:text-gray-400 focus:border-gray-500 focus:outline-none focus:ring-1 focus:ring-gray-500" %>
    <p class="mt-2 text-sm text-gray-500">Use an address that belongs to you and is different from your primary email.</p>
  </div>

  <div class="mt-6 flex items-center gap-4">
    <%= form.submit class: "rounded-md bg-gray-950 px-4 py-2 text-sm font-medium text-white hover:bg-gray-800" %>
    <%= link_to "Cancel", users_aliases_path, class: "text-sm font-medium text-gray-600 hover:text-gray-950" %>
  </div>
<% end %>
